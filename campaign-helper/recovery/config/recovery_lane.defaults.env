# Recovery lane identity (MAIN sets EV/PREP/RUN_ID/ATTEMPT before calling bin/recovery_phase.sh).
# Never point these at baseline/aux/shared campaign ports.

RECOVERY_REST_PORT=28133
RECOVERY_OLR_PORT=39233
RECOVERY_TAP_PORT=39433
BASELINE_REST_PORT=28132
BASELINE_OLR_PORT=39232
AUX_FLINK_REST_PORT=28140

CONNECTOR_NAME_PREFIX=ocr370-rac9-live-srl
TOPIC_PREFIX_TEMPLATE=ocr370.live.srl

# Bounded waits (seconds); timeout -> FAIL/INCONCLUSIVE in phase record, not silent pass.
WAIT_STOPPED_S=120
WAIT_RUNNING_S=180
WAIT_CATCHUP_S=240
WAIT_INFLIGHT_POLL_S=8
WAIT_OLR_STOP_S=90

# MAIN integration paths (on CDP / prep tree after copy).
WORKER_PROPS_BASENAME=worker-recovery.properties
REGISTER_JSON_BASENAME=register-recovery.json
WORKER_PGREP_PATTERN=ConnectDistributed
